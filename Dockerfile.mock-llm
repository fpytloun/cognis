FROM python:3.12-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir starlette uvicorn pyyaml

# Copy only the testing module
COPY cognis/testing/ /app/cognis/testing/
COPY cognis/__init__.py /app/cognis/__init__.py

# Expose port
EXPOSE 8090

# Run the mock LLM server
CMD ["python", "-m", "cognis.testing.mock_llm"]
