[Unit]
Description=Cognis Executor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.cognis/executor.env
# PyPI install (uvx):
ExecStart=%h/.local/bin/uvx cognis-executor
# Git checkout — uncomment and adjust path instead:
# ExecStart=/usr/bin/uv run --project /path/to/cognis cognis-executor
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
