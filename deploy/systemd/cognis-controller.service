[Unit]
Description=Cognis Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cognis
Group=cognis
EnvironmentFile=/etc/cognis/controller.env
# PyPI install (uvx):
ExecStart=/usr/bin/uvx cognis serve
# Git checkout — uncomment and set WorkingDirectory instead:
# WorkingDirectory=/opt/cognis
# ExecStart=/usr/bin/uv run cognis serve
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
