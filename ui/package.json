{
  "name": "cognis-ui",
  "version": "0.14.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:standalone": "svelte-kit sync && vite build --config vite.standalone.config.ts && node scripts/check-standalone-build.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run test:rich-screenshot",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:rich-screenshot": "node --test scripts/lib/rich-screenshot.test.mjs scripts/lib/rich-screenshot-paths.test.mjs",
    "generate:pwa-assets": "node scripts/generate-pwa-assets.mjs",
    "screenshot:rich": "node scripts/screenshot-rich-scenario.mjs",
    "screenshot:rich-gallery": "node scripts/screenshot-rich-gallery.mjs"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.14",
    "highlight.js": "^11.11.1",
    "lucide-svelte": "1.0.1",
    "marked": "17.0.5",
    "mermaid": "^11.17.2",
    "qrcode": "^1.5.4",
    "svelte": "5.56.8",
    "tailwind-merge": "3.5.0",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-static": "3.0.8",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.3.1",
    "@types/node": "25.5.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "10.4.27",
    "jsdom": "29.0.1",
    "postcss": "8.5.26",
    "shadcn-svelte": "1.2.4",
    "sharp": "0.35.4",
    "svelte-check": "4.4.5",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.2"
  }
}
